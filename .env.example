# MySQL connection (XAMPP default uses user=root and empty password)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=survival_db

# JWT Configuration
JWT_SECRET=cambiar_en_produccion_a_algo_seguro
JWT_EXPIRES=1h

# Google OAuth Configuration
# Use the web application client ID from Google Cloud and add http://localhost:4200
# to the authorized JavaScript origins for this OAuth client.
SESSION_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SESSION_SECRET=your-google-client-secret

# Server Port
PORT=3000
