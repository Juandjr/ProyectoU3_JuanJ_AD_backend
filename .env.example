# JWT Configuration
JWT_SECRET=cambiar_en_produccion_a_algo_seguro_minimo_32_chars
JWT_EXPIRES=1h

# Google OAuth Configuration
# Registra tu app en https://console.cloud.google.com y agrega http://localhost:4200
# a los orígenes de JavaScript autorizados.
SESSION_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SESSION_SECRET=your-google-client-secret

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Email (Gmail App Password)
EMAIL_USER=tu-correo@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
CODE_TTL_MINUTES=10
MAX_VERIFICATION_ATTEMPTS=5
MFA_ISSUER=Aplicaciones Distribuidas
MFA_WINDOW=1

# PayPal (Sandbox)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPhone
PAYPHONE_BASE_URL=https://pay.payphonetodoesposible.com
PAYPHONE_TOKEN=your-payphone-token
PAYPHONE_STORE_ID=your-payphone-store-id

# ──────────────────────────────────────────────────────
# Supabase PostgreSQL — https://supabase.com/dashboard
# ──────────────────────────────────────────────────────
# URL del proyecto (sin slash final)
SUPABASE_URL=https://<project-ref>.supabase.co

# Nuevas API Keys (Settings → API Keys)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-publishable-key>
SUPABASE_SECRET_KEY=sb_secret_<tu-secret-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Conexión directa PostgreSQL (Settings → Database → Connection string)
# Reemplaza [YOUR-PASSWORD] con tu contraseña de base de datos
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=[YOUR-PASSWORD]

# También disponibles como NEXT_PUBLIC_ para el frontend
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-publishable-key>
